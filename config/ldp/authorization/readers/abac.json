{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": [
        "Grants access based on the attributes of the requesting agent, the target resource and the request itself.",
        "Never returns `false`."
      ],
      "@id": "urn:solid-server:default:AbacPermissionReader",
      "@type": "AbacPermissionReader",
      "identifierStrategy": { "@id": "urn:solid-server:default:IdentifierStrategy" },
      "environmentResolver": {
        "comment": [
          "Values the attributes describing the request itself.",
          "Override this instance to set the business hours and the internal networks of a deployment."
        ],
        "@id": "urn:solid-server:default:EnvironmentAttributeResolver",
        "@type": "EnvironmentAttributeResolver",
        "businessHoursStart": "09:00",
        "businessHoursEnd": "17:00",
        "internalNetworks": [
          "^127\\.",
          "^::1$",
          "^::ffff:127\\."
        ]
      },
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "excludePaths": [
        "^$",
        "^/\\..*"
      ],
      "loader": {
        "comment": "Reads the ABAC store directly through the ResourceStore, bypassing authorization.",
        "@id": "urn:solid-server:default:AbacDataLoader",
        "@type": "AbacDataLoader",
        "store": { "@id": "urn:solid-server:default:ResourceStore" },
        "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
        "container": ".abac/"
      }
    },
    {
      "comment": "Routes requests on the ABAC store to the reader that guards it.",
      "@id": "urn:solid-server:default:PathBasedReader",
      "@type": "PathBasedReader",
      "paths": [
        {
          "PathBasedReader:_paths_key": "^/\\.abac(/.*)?$",
          "PathBasedReader:_paths_value": {
            "comment": "Only the ABAC administrator may write the store, while anyone may read its definitions and rules. Returns explicit `false`.",
            "@id": "urn:solid-server:default:AbacStoreReader",
            "@type": "AbacStoreReader",
            "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
            "admin": {
              "@id": "urn:solid-server:custom:variable:abacAdmin",
              "@type": "Variable"
            },
            "container": ".abac/"
          }
        }
      ]
    },
    {
      "comment": [
        "Evaluates ABAC grants beside ACP, so they are interpreted the same way:",
        "an ACR is only accessible through Control, and create and delete depend on the parent container."
      ],
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:AuthAuxiliaryReader" },
      "overrideParameters": {
        "@type": "AuthAuxiliaryReader",
        "reader": {
          "@type": "UnionPermissionReader",
          "readers": [
            { "@id": "urn:solid-server:default:AcpReader" },
            { "@id": "urn:solid-server:default:AbacPermissionReader" }
          ]
        }
      }
    }
  ]
}
