{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": "Grants access based on the requesting agent's attributes in the ABAC store. Never returns `false`.",
      "@id": "urn:solid-server:default:AbacPermissionReader",
      "@type": "AbacPermissionReader",
      "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "excludePaths": [
        "^$",
        "^/\\..*"
      ],
      "loader": {
        "comment": "Reads the ABAC store directly through the ResourceStore, bypassing authorization.",
        "@id": "urn:solid-server:default:AbacDataLoader",
        "@type": "AbacDataLoader",
        "store": { "@id": "urn:solid-server:default:ResourceStore" },
        "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
        "container": ".abac/"
      }
    },
    {
      "comment": "Routes requests on the ABAC store to the reader that guards it.",
      "@id": "urn:solid-server:default:PathBasedReader",
      "@type": "PathBasedReader",
      "paths": [
        {
          "PathBasedReader:_paths_key": "^/\\.abac(/.*)?$",
          "PathBasedReader:_paths_value": {
            "comment": "Only the ABAC administrator may write the store, while anyone may read its definitions and rules. Returns explicit `false`.",
            "@id": "urn:solid-server:default:AbacStoreReader",
            "@type": "AbacStoreReader",
            "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
            "admin": {
              "@id": "urn:solid-server:custom:variable:abacAdmin",
              "@type": "Variable"
            },
            "container": ".abac/"
          }
        }
      ]
    },
    {
      "comment": "Adds the ABAC reader to the existing union, so an explicit `false` from any other reader still wins.",
      "@id": "urn:solid-server:default:UnionPermissionReader",
      "@type": "UnionPermissionReader",
      "readers": [
        { "@id": "urn:solid-server:default:AbacPermissionReader" }
      ]
    }
  ]
}
