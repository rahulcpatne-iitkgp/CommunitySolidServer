{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "import": [
    "css:config/ldp/authorization/abac/cli.json",
    "css:config/ldp/authorization/abac/resolver.json",
    "css:config/ldp/authorization/acp.json",
    "css:config/ldp/authorization/readers/abac.json"
  ],
  "@graph": [
    {
      "comment": "ACP authorization, with ABAC grants that the denials in the ACRs override."
    },
    {
      "comment": "Records the circumstances of each request beside its credentials, as the ABAC rules can depend on them.",
      "@id": "urn:solid-server:default:UnionCredentialsExtractor",
      "@type": "UnionCredentialsExtractor",
      "extractors": [
        { "@type": "EnvironmentCredentialsExtractor" }
      ]
    }
  ]
}
